# Copy to .env and fill in the keys. Never commit .env.

# Domain: china_ecommerce uses Chinese e-commerce data with Nike/Adidas/Lululemon/Under Armour
DOMAIN=china_ecommerce

# Generation: DeepSeek (fast, cheap, OpenAI-compatible)
LLM_PROVIDER=openai_compat
OPENAI_COMPAT_API_KEY=your_deepseek_key_here
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_MODEL=deepseek-chat
OPENAI_COMPAT_MODEL_SMALL=qwen-turbo

# Small/routing model: Qwen via DashScope OpenAI-compatible mode
OPENAI_COMPAT_SMALL_API_KEY=your_qwen_key_here
OPENAI_COMPAT_SMALL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Independent evaluation judge (Qwen by default; keep separate from the generation model)
JUDGE_API_KEY=your_qwen_key_here
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MODEL=qwen-plus

# Embeddings: Qwen text-embedding-v3 (1024-dim, batch size <= 10)
EMBED_PROVIDER=qwen
QWEN_API_KEY=your_qwen_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024

# Reranker: set to "none" to disable, or "cohere" to enable
RERANK_PROVIDER=none

# Lightweight local mode (no Docker required)
VECTOR_PROVIDER=memory
GRAPH_PROVIDER=memory

# Transcription / TTS
TRANSCRIBE_PROVIDER=fake
TTS_PROVIDER=none

# Chat brain: "omni" = routed multi-lane, "linear" = single pipeline
CHAT_BRAIN=omni

# App
RATE_LIMIT=300/minute
REVIEW_QUEUE_DB=.review_queue.db
ALLOWED_ORIGINS=*
DEMO_READONLY=false

# Auth
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
AUTH_DB_PATH=.auth.db
DEMO_USERNAME=demo
DEMO_PASSWORD=demo12345
DEMO_CUSTOMER_NAME=张伟
DEMO_CUSTOMER_EMAIL=zhangwei@example.com
TURNSTILE_SECRET_KEY=

# Landing-page gate
GATE_USERNAME=
GATE_PASSWORD=

# Optional: Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
